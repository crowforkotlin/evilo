{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "evilo Plugin Catalog, Schema 1",
  "description": "Editor-facing shape validation. CatalogParser also checks URL policy, dates, identities, release compatibility, and source provenance. Certification is not a safety guarantee.",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "description", "updatedAt", "plugins"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "name": {"$ref": "#/$defs/name"},
    "description": {"type": "string", "maxLength": 4096},
    "updatedAt": {"$ref": "#/$defs/date"},
    "plugins": {
      "type": "array",
      "maxItems": 512,
      "items": {"$ref": "#/$defs/plugin"}
    }
  },
  "additionalProperties": true,
  "$defs": {
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "name": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S"},
    "date": {"type": "string", "format": "date-time"},
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"
    },
    "versionCode": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "httpUrl": {
      "type": "string",
      "maxLength": 4096,
      "format": "uri",
      "pattern": "^https?://[^\\s\\\\#]+$"
    },
    "sourceUrl": {
      "allOf": [
        {"$ref": "#/$defs/httpUrl"},
        {"not": {"pattern": "\\?"}}
      ],
      "description": "A repository or immutable source snapshot, never a manifest or Wasm binary. CatalogParser checks decoded binary suffixes. Publishers must supply actual source code."
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"}
    },
    "kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["manga", "novel", "anime", "film"]}
    },
    "author": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "url": {"anyOf": [{"$ref": "#/$defs/httpUrl"}, {"type": "null"}]}
      },
      "additionalProperties": true
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"}
    },
    "protocol": {
      "type": "object",
      "properties": {
        "major": {"type": "integer", "minimum": 1, "default": 1},
        "minimumMinor": {"type": "integer", "minimum": 0, "default": 0},
        "requiredCapabilities": {"$ref": "#/$defs/capabilities", "default": ["media.catalog.v1"]},
        "optionalCapabilities": {"$ref": "#/$defs/capabilities", "default": []}
      },
      "additionalProperties": true
    },
    "httpAccess": {
      "type": "object",
      "properties": {
        "origins": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/httpUrl"},
          "default": []
        },
        "pathPrefixes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^/[^\\s\\\\%?#]*$"},
          "default": ["/"]
        },
        "methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE"]},
          "default": ["GET"]
        },
        "headers": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9!#$%&'*+.^_`|~-]+$",
            "not": {"enum": ["cookie", "cookie2", "host", "connection", "content-length", "transfer-encoding", "upgrade", "proxy-authorization", "proxy-connection", "forwarded", "x-forwarded-for", "x-forwarded-host", "origin", "access-control-request-headers", "access-control-request-method", "sec-fetch-site", "sec-fetch-mode", "sec-fetch-dest"]}
          },
          "default": ["accept", "user-agent"]
        }
      },
      "additionalProperties": true
    },
    "permissions": {
      "type": "object",
      "properties": {
        "api": {"$ref": "#/$defs/httpAccess"},
        "media": {
          "allOf": [
            {"$ref": "#/$defs/httpAccess"},
            {"properties": {"methods": {"const": ["GET"]}}}
          ]
        },
        "storage": {"type": "boolean", "default": false}
      },
      "additionalProperties": true
    },
    "release": {
      "type": "object",
      "required": ["version", "versionCode", "kinds", "languages", "manifestUrl", "sourceUrl", "sourceRevision", "sourceArchiveUrl", "sourceArchiveSha256", "publishedAt"],
      "properties": {
        "version": {"$ref": "#/$defs/version"},
        "versionCode": {"$ref": "#/$defs/versionCode"},
        "kinds": {"$ref": "#/$defs/kinds"},
        "languages": {"$ref": "#/$defs/languages"},
        "manifestUrl": {"allOf": [{"$ref": "#/$defs/httpUrl"}, {"pattern": "\\.wlm$", "not": {"pattern": "\\?"}}]},
        "sourceUrl": {"$ref": "#/$defs/sourceUrl"},
        "sourceRevision": {"type": "string", "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"},
        "sourceArchiveUrl": {
          "allOf": [
            {"$ref": "#/$defs/httpUrl"},
            {"not": {"pattern": "\\?"}}
          ],
          "description": "Direct source ZIP or tar.gz URL. CatalogParser checks the decoded suffix."
        },
        "sourceArchiveSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "publishedAt": {"$ref": "#/$defs/date"},
        "usable": {"type": "boolean", "default": true},
        "minimumHostVersionCode": {"$ref": "#/$defs/versionCode", "default": 1},
        "maximumHostVersionCode": {"anyOf": [{"$ref": "#/$defs/versionCode"}, {"type": "null"}], "default": null},
        "protocol": {"$ref": "#/$defs/protocol"},
        "permissions": {"$ref": "#/$defs/permissions"}
      },
      "additionalProperties": true
    },
    "plugin": {
      "type": "object",
      "required": ["id", "name", "authors", "overseas", "languages", "kinds", "nsfw", "description", "sourceUrl", "iconUrl", "version", "createdAt", "updatedAt", "availableVersions"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"$ref": "#/$defs/name"},
        "authors": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/author"}},
        "overseas": {"type": "boolean"},
        "languages": {"$ref": "#/$defs/languages"},
        "kinds": {"$ref": "#/$defs/kinds"},
        "nsfw": {"type": "boolean"},
        "description": {"type": "string", "minLength": 1, "maxLength": 8192, "pattern": "\\S"},
        "sourceUrl": {"$ref": "#/$defs/sourceUrl"},
        "iconUrl": {"$ref": "#/$defs/httpUrl"},
        "version": {"$ref": "#/$defs/version"},
        "createdAt": {"$ref": "#/$defs/date"},
        "updatedAt": {"$ref": "#/$defs/date"},
        "forceUpdate": {"type": "boolean", "default": false},
        "minimumUsableVersionCode": {"$ref": "#/$defs/versionCode", "default": 1},
        "certified": {"type": "boolean", "default": false},
        "availableVersions": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/release"}}
      },
      "additionalProperties": true
    }
  }
}
